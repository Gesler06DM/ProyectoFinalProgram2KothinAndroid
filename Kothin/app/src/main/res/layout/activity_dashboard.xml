<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hola, bienvenido"
            android:textColor="#1E293B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tu resumen financiero"
            android:textColor="#64748B"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Saldo disponible"
            android:textColor="#2563EB"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Q 0.00"
            android:textColor="#1E293B"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Total de ingresos"
            android:textColor="#15803D"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtIngresos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Q 0.00"
            android:textColor="#15803D"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Total de gastos"
            android:textColor="#DC2626"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtGastos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Q 0.00"
            android:textColor="#DC2626"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAgregarIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Agregar ingreso"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnAgregarGasto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Agregar gasto"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Últimos movimientos"
            android:textColor="#1E293B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Todavía no hay movimientos registrados."
            android:textColor="#64748B"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
